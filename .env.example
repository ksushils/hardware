DATABASE_URL="file:./dev.db"
# Long random string used to sign session cookies and order links
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL (used in emails, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Stripe (optional). Leave empty to use the built-in demo card gateway.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Transactional email via Resend (optional). Without it, emails are logged in Admin → Settings → Notifications.
RESEND_API_KEY=""
EMAIL_FROM="TechRevive <support@techrevive.ae>"
# Admin account created by the seed script
ADMIN_EMAIL="admin@techrevive.ae"
ADMIN_PASSWORD="admin12345"
# Private document storage (licences, dispute evidence). Keep OUTSIDE the web root.
PRIVATE_DIR="./private-uploads"
# Secret for the scheduled jobs (/api/cron/*). Required for the jobs to run.
CRON_SECRET=""
# Minutes before an unpaid card order releases its stock (default 60)
UNPAID_ORDER_MINUTES="60"
